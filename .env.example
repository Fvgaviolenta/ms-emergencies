# =====================================================
# Infraestructura local (docker-compose)
# Copia este archivo a .env y ajusta los valores
# =====================================================

# PostgreSQL + PostGIS (LOCAL EN WINDOWS, fuera de Docker)
# Usa tus credenciales reales de PostgreSQL local.
POSTGRES_HOST=localhost
# Cuando ms-emergencies corre dentro de Docker, localhost apunta al contenedor.
# Docker Desktop permite llegar al PostgreSQL de Windows usando host.docker.internal.
POSTGRES_DOCKER_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=tu-clave-superuser

# Usuario de aplicación para ms-emergencies (opcional; lo crea el script SQL)
MS_EMERGENCIES_DB_USER=catastrofescl
MS_EMERGENCIES_DB_PASSWORD=catastrofescl
MS_EMERGENCIES_DB_NAME=catastrofescl_emergencies

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# =====================================================
# ms-emergencies (perfil dev/prod)
# =====================================================
MS_EMERGENCIES_DB_URL=jdbc:postgresql://localhost:5432/catastrofescl_emergencies

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

REDIS_HOST=localhost
REDIS_PORT=6379

# Firebase (Auth + custom claims en tokens)
# Para validar ID tokens en ms-emergencies con perfil dev: FIREBASE_ENABLED=true y credenciales abajo.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=tu-proyecto-firebase
# JSON de cuenta de servicio (Firebase console > Configuracion del proyecto > Cuentas de servicio).
# Nunca commitear este archivo; en Docker puedes montarlo y apuntar FIREBASE_CREDENTIALS_PATH al path interno.
FIREBASE_CREDENTIALS_PATH=
# Alternativa: credenciales ADC (local o CI). Si FIREBASE_CREDENTIALS_PATH esta vacio, el Admin SDK intenta ADC.
GOOGLE_APPLICATION_CREDENTIALS=

# En dev, si FIREBASE_ENABLED=false, se usa el filtro X-Dev-* (Swagger / pruebas sin token).
MS_EMERGENCIES_AUTH_DEV_MODE=true

# CORS para perfil prod (dominio del frontend)
FRONTEND_ORIGIN=https://catastrofescl.vercel.app
